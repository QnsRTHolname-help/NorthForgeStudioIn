# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# NorthForge environment
# Copy to `.env` and fill in. NEVER commit `.env`.
# Values prefixed VITE_ are public (bundled into the browser).
# Everything else is server-only and is never sent to the client.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€ Server â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173
# SQLite file location (relative to /server)
DATABASE_FILE=server/data/northforge.db

# â”€â”€ Auth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# â”€â”€ WhatsApp Cloud API (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_NUMBER=+91 91870 06703

# â”€â”€ API location (bundled) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Leave unset when the API is served from the same domain as the site
# (default `/api`). Set it when the site and API are deployed separately:
#   VITE_API_URL=https://api.yourdomain.com
# The API's CLIENT_ORIGIN must then include the site's origin.
VITE_API_URL=

# â”€â”€ Public (bundled) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Site URL used for canonical links + OpenGraph.
VITE_SITE_URL=https://northforgestudio.vercel.app
# WhatsApp number in international format, digits only (country code, no +).
# This is the number every "Message us" button opens a chat with.
VITE_WHATSAPP_NUMBER=919187006703

# ── Supabase (public, bundled) ──────────────────────────────
# Project URL + PUBLISHABLE (anon) key only. The secret key must never
# appear in any Vite-prefixed variable or client bundle.
#
# IMPORTANT (spec §26): Vite only exposes variables prefixed with VITE_ to
# the browser. The unprefixed pair is for the legacy/optional server. On
# Vercel, set BOTH names in every environment (Production, Preview,
# Development) and redeploy after changing them.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key


# ── SEO / analytics (public, bundled; optional) ─────────────
# Google Analytics 4 measurement ID (format G-XXXXXXXXXX).
# Leave unset and no analytics script is loaded at all.
VITE_GA4_ID=
# Google Search Console verification token (content= value of the
# google-site-verification meta tag). Injected at runtime when set.
VITE_GOOGLE_SITE_VERIFICATION=


# ── WhatsApp Cloud API (Supabase Edge Function secrets, NOT Vite) ──
# Set with: supabase secrets set WHATSAPP_ACCESS_TOKEN=… WHATSAPP_PHONE_NUMBER_ID=… WHATSAPP_VERIFY_TOKEN=…
# See docs/WHATSAPP_SETUP.md. Until set, the admin inbox falls back to wa.me deep links (still fully usable).
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

